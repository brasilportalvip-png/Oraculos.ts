# ==============================================================================
# ORACULOS.TS - Variáveis de Ambiente e Configurações de Produção
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Inteligência Artificial (Backend - Server-Side Only)
# ------------------------------------------------------------------------------
# Chave da API do Google Gemini AI (gemini-3.6-flash / gemini-3.7-flash)
# Finalidade: Consultas oraculares automatizadas, geração de artigos SEO e relatórios
# Escopo: Backend exclusivo (nunca expor no frontend ou variáveis VITE_*)
# Requisito: Obrigatório para recursos de IA
GEMINI_API_KEY=

# Modelos permitidos no backend. Use nomes disponíveis na sua conta Google AI.
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_EMERGENCY_MODEL=gemini-2.0-flash-lite

# ------------------------------------------------------------------------------
# 2. Mercado Pago - Gateway de Pagamentos e Webhooks (Backend - Server-Side Only)
# ------------------------------------------------------------------------------
# Token de acesso de produção ou homologação do Mercado Pago
# Finalidade: Criação de preferências de pagamento PIX/Cartão e consulta de transações
# Escopo: Backend exclusivo
# Requisito: Obrigatório para checkout e recargas
MERCADOPAGO_ACCESS_TOKEN=

# Chave Pública do Mercado Pago (Public Key / API Key)
# Finalidade: Inicialização de componentes client-side e checkout transparente
# Escopo: Frontend / Backend
VITE_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_PUBLIC_KEY=

# Segredo de validação de assinatura de Webhook do Mercado Pago (HMAC SHA-256)
# Finalidade: Validação criptográfica do cabeçalho x-signature contra ataques de replay e falsificação
# Escopo: Backend exclusivo
# Requisito: Obrigatório em ambiente de produção (process.env.NODE_ENV === 'production')
MERCADOPAGO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Backend - Server-Side Only)
# ------------------------------------------------------------------------------
# ID do Projeto Firebase
FIREBASE_PROJECT_ID=

# Chave JSON de Conta de Serviço do Firebase (opcional, codificada em Base64 ou string JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternativa ao JSON/Base64 acima. Não configure os dois formatos ao mesmo tempo.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternativa exclusiva para ambientes com credencial montada como arquivo.
# Não é normalmente necessária na Vercel.
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# 4. Firebase Web Client SDK (Frontend - Variáveis Públicas VITE_*)
# ------------------------------------------------------------------------------
# Finalidade: Conexão direta do cliente para Autenticação e Firestore
# Escopo: Frontend (seguro para exposição pública via build Vite)
# Requisito: Obrigatório para autenticação de usuários
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 5. Aplicação e controles de execução
# ------------------------------------------------------------------------------
# URL pública canônica sem barra final.
APP_URL=https://oraculos-ts.vercel.app

# Ative somente em produção. Desabilita qualquer autenticação simulada por headers.
STRICT_AUTH=true

# Valores gerenciados automaticamente pelo provedor; não criar manualmente na Vercel:
# VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA e NODE_ENV.

# IMPORTANTE:
# O código atual não lê APP_SECRET, JWT_SECRET ou SESSION_SECRET. Não invente uma
# variável "app secreta" sem antes implementar no backend o recurso que a consumirá.
